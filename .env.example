# Public site URL — used for canonical links, OG image absolute URLs, and
# sitemap generation. No trailing slash.
NUXT_PUBLIC_SITE_URL=https://northwindstudio.example

# Resend API key for the contact form. The form degrades to a dry-run
# transport when this is empty, so a fresh clone still builds.
RESEND_API_KEY=

# Address the contact form sends to. Defaults to site.business.email.
CONTACT_TO=hello@northwindstudio.example

# Verified From address in your Resend domain. The form will refuse to send
# (and dry-run) if this is missing.
CONTACT_FROM=noreply@northwindstudio.example

# Per-IP submissions allowed per hour. Default 5.
RATE_LIMIT_PER_HOUR=5

# Optional: Cloudflare Web Analytics beacon token. Leave blank to disable
# analytics entirely. The starter does not embed any other analytics.
NUXT_PUBLIC_CF_WEB_ANALYTICS_TOKEN=
