{
  "name": "client-site-starter",
  "version": "1.0.0",
  "private": true,
  "description": "Config-driven marketing site starter: Nuxt 3 + Tailwind, static export, Cloudflare Pages, Resend contact form.",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "build": "npm run check:config && nuxt generate",
    "preview": "nuxt preview",
    "check:config": "tsx scripts/check-config.ts",
    "typecheck": "nuxt prepare && vue-tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "verify": "npm run check:config && npm run typecheck && npm run test && npm run build",
    "lighthouse": "tsx scripts/lighthouse.ts",
    "deploy": "tsx scripts/deploy.ts"
  },
  "dependencies": {
    "nuxt": "3.13.2",
    "resend": "4.0.1",
    "vue": "3.5.12",
    "vue-router": "4.4.5",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@nuxt/eslint": "0.5.7",
    "@tailwindcss/postcss": "4.0.0-beta.4",
    "@types/node": "22.7.5",
    "eslint": "9.12.0",
    "postcss": "8.4.47",
    "tailwindcss": "4.0.0-beta.4",
    "tsx": "4.19.1",
    "typescript": "5.6.3",
    "vitest": "^2.1.3",
    "vue-tsc": "2.1.6",
    "wrangler": "3.78.4"
  }
}
